# Copy to .env and edit. Every value is optional for a local `docker compose up`;
# the defaults in deploy/docker-compose.yml are fine for trying the stack out.
# All values below are placeholders, never commit real secrets.

# Docker image version to run (a published app version such as 0.1.0, or latest)
# TRACKER_VERSION=latest

# Postgres (used by the db container and to build DATABASE_URL for the containers)
POSTGRES_USER=tracker
POSTGRES_PASSWORD=change-me
POSTGRES_DB=tracker

# Connection string for running the apps on the host (pnpm dev). Inside Docker the
# containers always connect to the `db` service, whatever is set here.
DATABASE_URL=postgres://tracker:change-me@localhost:5432/tracker

# Reserved for signing features that arrive later. Login sessions do not use it: they are
# random tokens stored (hashed) in the database. Generate one with: openssl rand -base64 48
SESSION_SECRET=change-me-to-a-long-random-string

# Set to true when users reach the app over https (the session cookie then gets the Secure
# flag). Left unset, it is true exactly when PUBLIC_BASE_URL starts with https://.
# COOKIE_SECURE=false

# Host port the web container (Caddy) is published on
WEB_PORT=8080

# URL users reach the app at (invite and password-reset links, links in Telegram messages, etc.)
PUBLIC_BASE_URL=http://localhost:8080

# Container timezone and household defaults
TZ=Europe/London
BANK_HOLIDAY_REGION=england-and-wales

# How often the worker materialises occurrences and activates due ones, in milliseconds
# TICK_INTERVAL_MS=60000

# Telegram bot token from @BotFather. Leave empty and the bot just idles.
# Leave privacy mode ON in @BotFather (the default): the bot then only sees commands, replies to
# its own messages and @mentions, never normal chat in the house group.
TELEGRAM_BOT_TOKEN=
# The bot's username, with or without the @. It lets the web app offer a one-click t.me link for
# connecting a Telegram account; without it, people are shown a code to send to the bot instead.
TELEGRAM_BOT_USERNAME=
# How often the bot sends the group reminders that are due, in milliseconds
# DELIVERY_INTERVAL_MS=10000

# Web Push (notifications on phones and desktops, even when the app is closed). Leave the keys
# empty and push stays off. Generate a key pair once with
#   pnpm --filter @tracker/worker vapid:generate
# and keep it: browsers subscribe against the public key, so changing it later drops every
# existing subscription. Browsers only allow push on https (or http://localhost).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Who the push services can contact about this sender: a mailto: address or an https: URL.
# Defaults to PUBLIC_BASE_URL when that is https; without either, push stays off.
# VAPID_SUBJECT=mailto:you@example.com

# Public hostname of the iCal feed, and the Cloudflare Tunnel token that exposes it.
# The tunnel service arrives in a later PR.
ICAL_PUBLIC_HOST=calendar.kallum.uk
CLOUDFLARE_TUNNEL_TOKEN=
