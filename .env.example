# Copy to .env and edit. Every value is optional for a local `docker compose up`;
# the defaults in deploy/docker-compose.yml are fine for trying the stack out.
# All values below are placeholders, never commit real secrets.

# Postgres (used by the db container and to build DATABASE_URL for the containers)
POSTGRES_USER=tracker
POSTGRES_PASSWORD=change-me
POSTGRES_DB=tracker

# Connection string for running the apps on the host (pnpm dev). Inside Docker the
# containers always connect to the `db` service, whatever is set here.
DATABASE_URL=postgres://tracker:change-me@localhost:5432/tracker

# Random string used to sign sessions. Generate one with: openssl rand -base64 48
SESSION_SECRET=change-me-to-a-long-random-string

# Host port the web container (Caddy) is published on
WEB_PORT=8080

# URL users reach the app at (links in Telegram messages, etc.)
PUBLIC_BASE_URL=http://localhost:8080

# Container timezone and household defaults
TZ=Europe/London
BANK_HOLIDAY_REGION=england-and-wales

# Telegram bot token from @BotFather. Leave empty and the bot just idles.
TELEGRAM_BOT_TOKEN=

# Public hostname of the iCal feed, and the Cloudflare Tunnel token that exposes it.
# The tunnel service arrives in a later PR.
ICAL_PUBLIC_HOST=calendar.kallum.uk
CLOUDFLARE_TUNNEL_TOKEN=
