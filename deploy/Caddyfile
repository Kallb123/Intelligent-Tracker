{
	admin off
	auto_https off
}

:80 {
	encode zstd gzip

	# API and calendar feed go to the backend; everything else is the SPA.
	@backend path /api/* /ical/*
	handle @backend {
		reverse_proxy api:3000
	}

	handle {
		root * /srv

		# Vite emits content-hashed files under /assets, so they can be cached forever.
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		@pages not path /assets/*
		header @pages Cache-Control "no-cache"
		# This covers /sw.js (the service worker, which has to be revalidated on every visit so an
		# update is noticed) and index.html. The worker is one self-contained file at the root, so
		# its scope is already the whole app and it needs no Service-Worker-Allowed header.

		# Not in every system mime table, and installable-app checks look at the type.
		@manifest path /manifest.webmanifest
		header @manifest Content-Type application/manifest+json

		try_files {path} /index.html
		file_server
	}
}
